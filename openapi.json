  "components": {
    "schemas": {
      "BalanceChangeReasonItem": {
        "properties": {
          "reason": { "$ref": "#/components/schemas/BalanceChangeReasons" },
          "type": { "$ref": "#/components/schemas/BalanceChangeType" }
        },
        "type": "object",
        "required": ["reason", "type"],
        "title": "BalanceChangeReasonItem"
      },
      "BalanceChangeReasons": {
        "type": "string",
        "enum": [
          "theory",
          "practice_completed",
          "additional_task_completed",
          "accidental_punish",
          "discipline_breakdown",
          "middle_level_violation",
          "serious_violation",
          "accidental_reward"
        ],
        "title": "BalanceChangeReasons"
      },
      "BalanceChangeReasonsResponse": {
        "properties": {
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "status": { "type": "string", "title": "Status", "default": "success" },
          "reasons": {
            "items": { "$ref": "#/components/schemas/BalanceChangeReasonItem" },
            "type": "array",
            "title": "Reasons"
          }
        },
        "type": "object",
        "required": ["reasons"],
        "title": "BalanceChangeReasonsResponse"
      },
      "BalanceChangeRequest": {
        "properties": {
          "reason": {
            "items": { "$ref": "#/components/schemas/BalanceChangeReasons" },
            "type": "array",
            "minItems": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": ["reason"],
        "title": "BalanceChangeRequest"
      },
      "BalanceChangeResponse": {
        "properties": {
          "balance": { "type": "integer", "title": "Balance" },
          "transaction": { "$ref": "#/components/schemas/BalanceTransactionResponse" },
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "status": { "type": "string", "title": "Status", "default": "success" }
        },
        "type": "object",
        "required": ["balance", "transaction"],
        "title": "BalanceChangeResponse"
      },
      "BalanceChangeType": {
        "type": "string",
        "enum": ["punish", "reward"],
        "title": "BalanceChangeType"
      },
      "BalanceHistoryResponse": {
        "properties": {
          "transactions": {
            "items": { "$ref": "#/components/schemas/BalanceTransactionResponse" },
            "type": "array",
            "title": "Transactions"
          },
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "status": { "type": "string", "title": "Status", "default": "success" }
        },
        "type": "object",
        "required": ["transactions"],
        "title": "BalanceHistoryResponse"
      },
      "BalanceResponse": {
        "properties": {
          "balance": { "type": "integer", "title": "Balance" },
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "status": { "type": "string", "title": "Status", "default": "success" }
        },
        "type": "object",
        "required": ["balance"],
        "title": "BalanceResponse"
      },
      "BalanceTransactionResponse": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "student_id": { "type": "integer", "title": "Student Id" },
          "operation": { "type": "string", "enum": ["deposit", "deduct"], "title": "Operation" },
          "amount": { "type": "integer", "title": "Amount" },
          "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Reason" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        },
        "type": "object",
        "required": ["id", "student_id", "operation", "amount", "reason", "created_at"],
        "title": "BalanceTransactionResponse"
      },
      "CourseCategory": {
        "type": "string",
        "enum": ["embedded", "game dev", "web", "primary", "python", "no category"],
        "title": "CourseCategory"
      },
      "CourseCreateRequest": {
        "properties": {
          "name": { "type": "string", "title": "Name", "description": "Name of the course" },
          "category": { "$ref": "#/components/schemas/CourseCategory", "default": "embedded" }
        },
        "type": "object",
        "required": ["name"],
        "title": "CourseCreateRequest"
      },
      "CourseGroupResponse": {
        "properties": {
          "status": { "type": "string", "title": "Status", "default": "success" },
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "id": { "type": "integer", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "course_id": { "type": "integer", "title": "Course Id" },
          "students_count": { "type": "integer", "title": "Students Count", "default": 0 },
          "teacher_ids": {
            "items": { "type": "integer" },
            "type": "array",
            "title": "Teacher Ids",
            "description": "User IDs of the group's teachers"
          }
        },
        "type": "object",
        "required": ["id", "name", "course_id"],
        "title": "CourseGroupResponse"
      },
      "CourseResponse": {
        "properties": {
          "status": { "type": "string", "title": "Status", "default": "success" },
          "code": { "type": "integer", "title": "Code", "default": 200 },
          "id": { "type": "integer", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "category": { "$ref": "#/components/schemas/CourseCategory" },
          "groups": {
            "items": { "$ref": "#/components/schemas/CourseGroupResponse" },
            "type": "array",
            "title": "Groups",
            "description": "Groups associated with the course"
          },
