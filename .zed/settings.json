{
  "format_on_save": "on",
  "prettier": { "allowed": false },
  "formatter": [
    { "language_server": { "name": "oxfmt" } },
    { "code_action": "source.fixAll.oxc" },
    { "code_action": "source.fixAll.stylelint" }
  ],
  "languages": {
    "JavaScript": {
      "language_servers": [
        "...",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server"
      ]
    },
    "TypeScript": {
      "language_servers": [
        "...",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server"
      ]
    },
    "TSX": {
      "language_servers": [
        "...",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!tailwindcss-language-server"
      ]
    }
  }
}
