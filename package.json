{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "kubb generate",
    "gen:api:dev": "bun --env-file=.env.development kubb generate",
    "db:generate": "bun --env-file=.env.development drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.development drizzle-kit migrate",
    "db:migrate:ci": "drizzle-kit migrate",
    "db:check": "bun --env-file=.env.development drizzle-kit check",
    "dev": "bun --bun --env-file=.env.development vite dev",
    "build": "vite build",
    "analyze": "vite build --mode analyze",
    "fmt": "oxfmt .",
    "lint": "oxlint .",
    "lint:css": "stylelint --allow-empty-input 'src/**/*.css'",
    "check": "bun run fmt && bun run lint && bun run lint:css && bun --check ",
    "prepare": "lefthook install --reset-hooks-path"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@kanjou/core": "^0.6.1",
    "@kanjou/react": "^0.6.1",
    "@sentry/tanstackstart-react": "^11.16.0",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/redact": "^0.3.1",
    "drizzle-orm": "^1.0.0-rc.5",
    "embla-carousel-react": "^8.6.0",
    "messageformat": "^4.1.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iivanpopov/stylelint": "^0.0.1",
    "@kanjou/cli": "^0.6.1",
    "@kanjou/generator": "^0.6.1",
    "@kanjou/plugin": "^0.6.1",
    "@kubb/adapter-oas": "^5.23.4",
    "@kubb/plugin-fetch": "^6.4.1",
    "@kubb/plugin-react-query": "^5.13.0",
    "@kubb/plugin-ts": "^5.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^1.0.0-rc.5",
    "kubb": "^5.23.4",
    "lefthook": "^2.2.2",
    "nitro": "^3.0.261103-rc",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "rollup-plugin-visualizer": "^7.1.3",
    "stylelint": "^18.1.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-recommended": "^19.1.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^7.0.2",
    "unocss": "^66.13.0",
    "vite": "^8.3.8"
  }
}
